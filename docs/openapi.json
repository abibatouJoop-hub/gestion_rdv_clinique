 un patient","operationId":"supprimer_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Patient supprimé"},"404":{"description":"Patient introuvable"}}}},"/api/medecins/{id}":{"get":{"tags":["Médecins"],"summary":"Consulter un médecin","operationId":"trouver_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Médecin trouvé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"404":{"description":"Médecin introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}}}},"put":{"tags":["Médecins"],"summary":"Modifier un médecin","operationId":"modifier_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MedecinRequest"}}},"required":true},"responses":{"200":{"description":"Médecin modifié","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"400":{"description":"Données invalides","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"404":{"description":"Médecin ou spécialité introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"409":{"description":"Conflit avec une donnée existante","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}}}},"delete":{"tags":["Médecins"],"summary":"Supprimer un médecin","operationId":"supprimer_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Médecin supprimé"},"404":{"description":"Médecin introuvable"},"409":{"description":"Le médecin a encore des créneaux"}}}},"/api/creneaux/{id}":{"get":{"tags":["Créneaux"],"summary":"Consulter un créneau","operationId":"trouver_3","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Créneau trouvé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"404":{"description":"Créneau introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}}}},"put":{"tags":["Créneaux"],"summary":"Modifier un créneau","description":"Impossible si le créneau est déjà réservé.","operationId":"modifier_3","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreneauRequest"}}},"required":true},"responses":{"200":{"description":"Créneau modifié","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"400":{"description":"Données invalides","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"404":{"description":"Créneau ou médecin introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"409":{"description":"Créneau réservé ou chevauchement","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}}}},"delete":{"tags":["Créneaux"],"summary":"Supprimer un créneau","description":"Impossible si le créneau est déjà réservé.","operationId":"supprimer_3","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Créneau supprimé"},"404":{"description":"Créneau introuvable"},"409":{"description":"Le créneau est déjà réservé"}}}},"/api/specialites":{"get":{"tags":["Spécialités"],"summary":"Lister les spécialités","description":"Résultats paginés et triables : page (à partir de 0), size, sort (ex. nom,desc).","operationId":"lister","parameters":[{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["nom,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"Page de spécialités","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelSpecialiteDto"}}}},"400":{"description":"Critère de tri invalide","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelSpecialiteDto"}}}}}},"post":{"tags":["Spécialités"],"summary":"Créer une spécialité","operationId":"creer","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SpecialiteRequest"}}},"required":true},"responses":{"201":{"description":"Spécialité créée","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SpecialiteDto"}}}},"400":{"description":"Données invalides (nom vide ou trop long)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SpecialiteDto"}}}},"409":{"description":"Une spécialité portant ce nom existe déjà","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SpecialiteDto"}}}}}}},"/api/rendez-vous":{"get":{"tags":["Rendez-vous"],"summary":"Lister les rendez-vous","description":"Filtres facultatifs : patient et statut. Résultats paginés et triables.","operationId":"lister_1","parameters":[{"name":"patientId","in":"query","description":"Identifiant du patient","required":false,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"statut","in":"query","description":"Statut : CONFIRME, ANNULE, ABSENT ou HONORE","required":false,"schema":{"type":"string","enum":["CONFIRME","ANNULE","ABSENT","HONORE"]}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["debut,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"Page de rendez-vous","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelRendezVousDto"}}}},"400":{"description":"Paramètre invalide (statut inconnu, tri inconnu)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelRendezVousDto"}}}}}},"post":{"tags":["Rendez-vous"],"summary":"Prendre un rendez-vous","description":"Réserve un créneau libre pour un patient. Un événement est publié, qui déclenche une notification de confirmation.\n\nRefusé (409) si : le créneau est déjà réservé, le patient est bloqué (5 points de pénalité ou plus), il a déjà 3 rendez-vous à venir, ou il a déjà un rendez-vous sur le même horaire.","operationId":"prendre","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RendezVousRequest"}}},"required":true},"responses":{"201":{"description":"Rendez-vous confirmé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"400":{"description":"Données invalides (patient ou créneau manquant)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"404":{"description":"Patient ou créneau introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"409":{"description":"Créneau déjà pris, patient bloqué, quota atteint ou horaire en conflit","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}}}}},"/api/rendez-vous/{id}/annulation":{"post":{"tags":["Rendez-vous"],"summary":"Annuler un rendez-vous","description":"Libère le créneau. Une annulation à moins de 24 h du rendez-vous ajoute 1 point de pénalité au patient. Si une liste d'attente existe pour ce créneau, le premier patient éligible obtient automatiquement le rendez-vous.","operationId":"annuler","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Rendez-vous annulé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"404":{"description":"Rendez-vous introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"409":{"description":"Rendez-vous non confirmé ou déjà passé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}}}}},"/api/rendez-vous/{id}/absence":{"post":{"tags":["Rendez-vous"],"summary":"Marquer un patient absent","description":"Possible seulement après l'heure du rendez-vous. Ajoute 2 points de pénalité au patient.","operationId":"marquerAbsent","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Absence enregistrée","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"404":{"description":"Rendez-vous introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"409":{"description":"Rendez-vous non confirmé ou pas encore passé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}}}}},"/api/rendez-vous/rappels":{"post":{"tags":["Rendez-vous"],"summary":"Déclencher les rappels J-1","description":"Envoie un rappel pour chaque rendez-vous confirmé dans les 24 prochaines heures qui n'en a pas encore reçu. Exécuté automatiquement toutes les heures ; cet endpoint sert aux tests.","operationId":"declencherRappels","responses":{"200":{"description":"Nombre de rappels envoyés","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"integer","format":"int32"}}}}}}}},"/api/rendez-vous/attente":{"get":{"tags":["Rendez-vous"],"summary":"Consulter la liste d'attente","description":"Toutes les inscriptions, groupées par créneau, avec la position de chaque patient dans la file.","operationId":"listerAttente","responses":{"200":{"description":"Inscriptions en liste d'attente","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AttenteDto"}}}}}}},"post":{"tags":["Rendez-vous"],"summary":"S'inscrire en liste d'attente","description":"Pour un créneau déjà réservé. Dès qu'il est libéré, le premier patient éligible de la file l'obtient.","operationId":"inscrireAttente","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RendezVousRequest"}}},"required":true},"responses":{"201":{"description":"Inscription enregistrée, avec la position dans la file","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttenteDto"}}}},"400":{"description":"Données invalides","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttenteDto"}}}},"404":{"description":"Patient ou créneau introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttenteDto"}}}},"409":{"description":"Créneau libre ou passé, déjà inscrit, patient bloqué, quota atteint ou horaire en conflit","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttenteDto"}}}}}}},"/api/patients":{"get":{"tags":["Patients"],"summary":"Rechercher des patients","description":"Recherche sur le nom, le prénom ou l'e-mail. Résultats paginés et triables. Le champ « bloque » vaut true à partir de 5 points de pénalité.","operationId":"rechercher","parameters":[{"name":"recherche","in":"query","description":"Fragment du nom, du prénom ou de l'e-mail","required":false,"schema":{"type":"string"},"example":"ndi"},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["nom,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"Page de patients","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelPatientDto"}}}},"400":{"description":"Critère de tri invalide","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelPatientDto"}}}}}},"post":{"tags":["Patients"],"summary":"Créer un patient","operationId":"creer_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatientRequest"}}},"required":true},"responses":{"201":{"description":"Patient créé, avec 0 point de pénalité","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatientDto"}}}},"400":{"description":"Données invalides (champ vide, e-mail mal formé)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatientDto"}}}},"409":{"description":"Un patient avec cet e-mail existe déjà","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatientDto"}}}}}}},"/api/medecins":{"get":{"tags":["Médecins"],"summary":"Rechercher des médecins","description":"Recherche multicritère : tous les filtres sont facultatifs et se combinent. Résultats paginés et triables.","operationId":"rechercher_1","parameters":[{"name":"nom","in":"query","description":"Fragment du nom ou du prénom, sans tenir compte des majuscules","required":false,"schema":{"type":"string"},"example":"dia"},{"name":"specialiteId","in":"query","description":"Identifiant de la spécialité","required":false,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"date","in":"query","description":"Médecins ayant au moins un créneau ce jour-là (AAAA-MM-JJ)","required":false,"schema":{"type":"string","format":"date"},"example":"2026-11-16"},{"name":"disponible","in":"query","description":"true : seulement les médecins ayant un créneau libre à venir","required":false,"schema":{"type":"boolean"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["nom,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"Page de médecins correspondant aux critères","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelMedecinDto"}}}},"400":{"description":"Paramètre invalide (date mal formée, tri inconnu)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelMedecinDto"}}}}}},"post":{"tags":["Médecins"],"summary":"Créer un médecin","operationId":"creer_2","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MedecinRequest"}}},"required":true},"responses":{"201":{"description":"Médecin créé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"400":{"description":"Données invalides","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"404":{"description":"Spécialité introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}},"409":{"description":"Conflit avec une donnée existante","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MedecinDto"}}}}}}},"/api/creneaux":{"get":{"tags":["Créneaux"],"summary":"Lister les créneaux","description":"Filtres facultatifs : médecin, jour, disponibilité. Résultats paginés et triables.","operationId":"lister_2","parameters":[{"name":"medecinId","in":"query","description":"Identifiant du médecin","required":false,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"date","in":"query","description":"Jour recherché (AAAA-MM-JJ)","required":false,"schema":{"type":"string","format":"date"},"example":"2026-11-16"},{"name":"libre","in":"query","description":"true : seulement les créneaux libres, false : seulement les réservés","required":false,"schema":{"type":"boolean"}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["debut,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"Page de créneaux","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelCreneauDto"}}}},"400":{"description":"Paramètre invalide (date mal formée, tri inconnu)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelCreneauDto"}}}}}},"post":{"tags":["Créneaux"],"summary":"Créer un créneau","description":"Le créneau doit commencer dans le futur, finir après son début, et ne pas chevaucher un autre créneau du même médecin.","operationId":"creer_3","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreneauRequest"}}},"required":true},"responses":{"201":{"description":"Créneau créé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"400":{"description":"Données invalides (fin avant début, date passée)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"404":{"description":"Médecin introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}},"409":{"description":"Chevauche un autre créneau du même médecin","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CreneauDto"}}}}}}},"/api/notifications/{id}/lue":{"patch":{"tags":["Notifications"],"summary":"Marquer une notification comme lue","operationId":"marquerLue","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Notification marquée comme lue","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NotificationDto"}}}},"404":{"description":"Notification introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NotificationDto"}}}}}}},"/api/rendez-vous/{id}":{"get":{"tags":["Rendez-vous"],"summary":"Consulter un rendez-vous","operationId":"trouver_4","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Rendez-vous trouvé","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}},"404":{"description":"Rendez-vous introuvable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RendezVousDto"}}}}}}},"/api/notifications":{"get":{"tags":["Notifications"],"summary":"Lister les notifications","description":"Les notifications sont créées en réponse aux événements : rendez-vous confirmé, annulé, ou rappel la veille. Les plus récentes sont renvoyées en premier.","operationId":"lister_3","parameters":[{"name":"patientId","in":"query","description":"Identifiant du patient","required":false,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"nonLues","in":"query","description":"true : seulement les notifications non lues","required":false,"schema":{"type":"boolean","default":false}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":20,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort